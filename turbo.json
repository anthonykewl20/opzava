{
  "$schema": "https://turborepo.com/schema.json",
  "envMode": "strict",
  "globalPassThroughEnv": [
    "DATABASE_URL",
    "DATABASE_MIGRATION_URL",
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_URL",
    "BROKER_INTERNAL_TOKEN",
    "BROKER_INTERNAL_URL",
    "PROVISIONING_WORKER_TOKEN",
    "PROVISIONING_WORKER_URL",
    "PROVISIONING_INTERNAL_TOKEN",
    "PROVISIONING_INTERNAL_URL",
    "GITHUB_ISSUES_REPOSITORY",
    "NODE_ENV",
    "APP_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "dist/**", "!.next/cache/**"]
    },
    "typecheck": {
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "format": {
      "outputs": []
    },
    "format:check": {
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
