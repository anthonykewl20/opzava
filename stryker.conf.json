{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "_comment": "Transient mutation-testing verification scoped to the F-finding safety-critical units added on docs/system-map-ledger. Run: pnpm exec stryker run",
  "packageManager": "pnpm",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "testRunner": "vitest",
  "vitest": { "configFile": "vitest.stryker.config.ts" },
  "coverageAnalysis": "perTest",
  "concurrency": 4,
  "timeoutMS": 60000,
  "reporters": ["clear-text", "json", "progress"],
  "jsonReporter": { "fileName": "reports/mutation/mutation.json" },
  "clearTextReporter": { "allowColor": false, "maxTestsToLog": 1 },
  "mutate": [
    "src/lib/model-config.ts",
    "src/lib/schedule-parser.ts",
    "src/opzava/modules/content/workflow/content-quality-gate.ts",
    "src/opzava/modules/content/campaign/campaign-send-approval.ts",
    "src/opzava/modules/content/campaign/run-approved-campaign.ts",
    "src/opzava/modules/content/providers/resolve-resend-campaign-connection.ts",
    "src/opzava/modules/content/providers/resolve-wordpress-draft-connection.ts",
    "src/opzava/modules/content/steps/wordpress-draft-service.ts",
    "src/opzava/platform/providers/env-secret-resolver.ts",
    "src/opzava/platform/runner/maintenance-daemon.ts",
    "src/opzava/platform/providers/limit-enforcement.ts",
    "src/opzava/platform/admin-config/runtime-options.ts",
    "src/opzava/modules/content/workflow/job-kind-executor.ts",
    "src/opzava/platform/costs/unified-cost-summary.ts",
    "src/opzava/platform/costs/unified-cost-reader.ts",
    "src/opzava/platform/audit/unified-audit.ts",
    "src/opzava/platform/observability/log-shipping.ts",
    "src/opzava/platform/observability/log-shipper.ts",
    "src/opzava/platform/observability/log-ship-transport.ts"
  ]
}
