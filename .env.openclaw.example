# Optional OpenClaw sidecar settings.
# Copy to `.env.openclaw` when running `OPENCLAW_ENABLED=1 make up`.

OPENCLAW_GATEWAY_IMAGE=ghcr.io/openclaw/openclaw:latest
OPENCLAW_GATEWAY_PORT=18789
OPENCLAW_GATEWAY_INTERNAL_PORT=18789
OPENCLAW_CONTROL_UI_PORT=18791
OPENCLAW_STATUS_HOST=127.0.0.1

# Set when your gateway requires token auth.
# OPENCLAW_GATEWAY_TOKEN=

OPENCLAW_TOOLS_PROFILE=coding
OPENCLAW_SECURITY_WORKSPACE_ONLY=1
OPENCLAW_SECURITY_DENY_AUTOMATION=1
OPENCLAW_SECURITY_DENY_RUNTIME=1
OPENCLAW_SECURITY_DENY_FS=0
OPENCLAW_SECURITY_SANDBOX_ALL=1

# Optional messaging/channel integration values consumed by the gateway.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_NUMERIC_USER_ID=
TELEGRAM_DM_POLICY=pairing
# TELEGRAM_ALLOW_FROM=
# TELEGRAM_OWNER_ALLOW_FROM=
