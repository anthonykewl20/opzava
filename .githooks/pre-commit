#!/usr/bin/env sh
# Pre-commit gate — dependency-free (the husky/lint-staged install was blocked by a pnpm store
# mismatch; this uses the already-installed eslint + the project's typecheck script instead).
# FAST per-commit checks only: staged-eslint + typecheck. The full `pnpm test:all`
# (unit + governance + build + e2e) stays in CI — it's slow and currently red on the unrelated
# `skills-lock.json` allowlist item. Activated via `git config core.hooksPath .githooks`
# (set by the `prepare` script on `pnpm install`).
set -eu

cd "$(git rev-parse --show-toplevel)"

# 1. Lint only the staged TS/TSX files (the lint-staged equivalent).
STAGED="$(git diff --cached --name-only --diff-filter=ACM -- '*.ts' '*.tsx' || true)"
if [ -n "$STAGED" ]; then
  echo "pre-commit: eslint (staged)…"
  # shellcheck disable=SC2086  # intentional word-split: one path per arg
  pnpm exec eslint --no-warn-ignored $STAGED
fi

# 2. Project typecheck (catches cross-file type breaks the staged lint can't see).
echo "pre-commit: typecheck…"
pnpm run typecheck

echo "pre-commit: OK"
