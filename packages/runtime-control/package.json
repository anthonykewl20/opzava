{
  "name": "@opzava/runtime-control",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./testing/runtime-conversation-store-contract": {
      "types": "./src/__tests__/contracts/runtime-conversation-store.contract.ts",
      "default": "./dist/__tests__/contracts/runtime-conversation-store.contract.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run"
  },
  "dependencies": {
    "@opzava/adapters": "workspace:*",
    "@opzava/ports": "workspace:*",
    "@opzava/project-management": "workspace:*",
    "@opzava/shared-kernel": "workspace:*",
    "drizzle-orm": "0.45.2"
  },
  "devDependencies": {
    "@opzava/config": "workspace:*",
    "@types/pg": "8.20.0",
    "pg": "8.22.0"
  }
}
