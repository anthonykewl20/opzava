{
  "name": "@opzava/identity-access",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./better-auth": {
      "types": "./src/adapters/better-auth/index.ts",
      "default": "./dist/adapters/better-auth/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.6.23",
    "@opzava/adapters": "workspace:*",
    "@opzava/ports": "workspace:*",
    "@opzava/shared-kernel": "workspace:*",
    "@simplewebauthn/server": "13.3.2",
    "better-auth": "1.6.23",
    "drizzle-orm": "0.45.2"
  },
  "devDependencies": {
    "@opzava/config": "workspace:*"
  }
}
