# Opzava environment configuration template.
# Copy to `.env` and replace placeholder values. Never commit the real `.env`.
# Secrets (AUTH_PASS, API_KEY, AUTH_SECRET) auto-generate on first run if left blank.

# --- Server ---
PORT=3000
# Legacy direct-host port for inherited tooling. Docker app-runtime traffic uses
# DOKPLOY_HTTP_PORT through Traefik instead of publishing the app port directly.
MC_PORT=3000
MC_URL_SCHEME=http
MC_HOST=127.0.0.1
# Hostnames the app will accept requests from in production (comma-separated).
# Leave unset for local dev. Required for any network-facing deploy.
# MC_ALLOWED_HOSTS=opzava.anito.ai
# MC_ALLOW_ANY_HOST=0              # NEVER set to 1 in production
# NEXT_PUBLIC_FORCE_HTTPS=1         # opt-in HTTPS redirect (set behind a TLS proxy)

# --- Docker operator workflow ---
# App-runtime is Docker-only:
#   make up dev    -> docker-compose.yml + docker-compose.dev.yml
#   make up parity -> docker-compose.yml + docker-compose.parity.yml
MC_MODE=parity                     # parity or dev
MC_HOST_CLI_ENABLED=0              # deliberate escape: include docker-compose.host-cli.yml for host CLI/session sharing
INSTALL_AGENT_CLIS=1               # bake claude/codex CLIs into the runtime image
NEXT_PUBLIC_CHAT_POLL_INTERVAL_MS=1000

# --- Local Dokploy parity ---
# Humans use http://opzava.localhost:3080; browser gateway traffic uses
# http://opzava-gateway.localhost:3080. Compose pins both .localhost names with
# extra_hosts for Linux/headless Docker resolution.
DOKPLOY_LOCAL_DOMAIN=opzava.localhost
DOKPLOY_GATEWAY_LOCAL_DOMAIN=opzava-gateway.localhost
DOKPLOY_HTTP_PORT=3080
DOKPLOY_TRAEFIK_IMAGE=traefik:v3.7.5
# OPZAVA_IMAGE=opzava-dokploy-local
# DOKPLOY_PARITY_RUN_E2E=1

# --- Auth & secrets (auto-generated on first run if blank) ---
AUTH_USER=admin
# AUTH_PASS=                        # strong 12+ char password; or use AUTH_PASS_B64 (base64)
# AUTH_PASS_B64=
# AUTH_SECRET=                      # session signing secret (random)
# API_KEY=                          # API key for headless/agent access (random)

# --- Data location ---
# MISSION_CONTROL_DATA_DIR=.data    # absolute path recommended for persistent Docker deploys
# MISSION_CONTROL_DB_PATH=          # overrides <DATA_DIR>/mission-control.db

# --- Cookies / transport hardening (set behind TLS) ---
# MC_COOKIE_SECURE=1
# MC_COOKIE_SAMESITE=strict
# MC_ENABLE_HSTS=1

# --- Rate limiting ---
# MC_DISABLE_RATE_LIMIT=            # leave unset in production; set 1 only for local/test
# MC_TRUSTED_PROXIES=               # comma-separated trusted proxy IPs/cidrs for correct client IP

# --- Gateway (Docker sidecar) ---
# OpenClaw/Hermes are Docker-sidecar runtime state, not host app-runtime state.
# The gateway writes Hermes data at /home/node/.hermes; Opzava reads the shared
# hermes-data volume at /home/nextjs/.hermes read-only.
OPENCLAW_GATEWAY_HOST=mc-openclaw-gateway
OPENCLAW_GATEWAY_PORT=18789
OPENCLAW_GATEWAY_INTERNAL_PORT=18789
# OPENCLAW_GATEWAY_TOKEN=           # optional gateway auth token; never commit a real token
OPENCLAW_STATE_DIR=/home/nextjs/.openclaw
OPENCLAW_CONFIG_PATH=/home/nextjs/.openclaw/openclaw.json
GATEWAY_OPTIONAL=false              # set true only for deliberate gateway-free standalone/dashboard mode
# PUBLIC_GATEWAY_HOST=              # runtime container env, not baked into the client bundle
# PUBLIC_GATEWAY_PORT=3080          # browser-reachable gateway port through local Traefik
# Operators set PUBLIC_GATEWAY_HOST to the browser-reachable gateway host. Empty
# locally means auto-detect plus the browser localStorage override. Do not use
# NEXT_PUBLIC_GATEWAY_* for normal Docker parity; those are build-time legacy vars.
# MC_DEFAULT_GATEWAY_NAME=primary

# --- Gateway-free direct dispatch ---
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
LOCAL_LLM_ENDPOINT=http://host.docker.internal:1234/v1
# LOCAL_LLM_API_KEY=
MC_HOST_SESSION_MODE=coexist        # coexist, block-active, or nudge

# --- Integrations ---
# MC_CLAUDE_HOME=~/.claude
# MC_WEBHOOK_MAX_RETRIES=5
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# NEXT_PUBLIC_APP_URL=

# --- Opzava provider connections (configured in the Settings UI, not here) ---
# WordPress site URL + app password, Resend API key, and sender identity are stored
# as admin settings via the Settings → Provider Connections panel. Use "Test" there
# to validate each live connection before running real workflows.
