DATABASE_URL=postgresql://opzava_app:opzava_app_local_only@localhost:15432/opzava
DATABASE_MIGRATION_URL=postgresql://opzava_owner:opzava_owner_local_only@localhost:15432/opzava
# Optional Docker-service override; keep unset for local compose defaults.
# COMPOSE_DATABASE_URL=postgresql://opzava_app:opzava_app_local_only@postgres:5432/opzava
APP_URL=http://web.opzava.localhost:18088
BETTER_AUTH_URL=http://web.opzava.localhost:18088
BETTER_AUTH_SECRET=opzava_local_dev_better_auth_secret_not_for_shared_envs
BROKER_INTERNAL_URL=http://gateway-broker.opzava.localhost:19088
BROKER_INTERNAL_TOKEN=opzava_local_dev_broker_internal_token_not_for_shared_envs
# Optional web -> provisioning-worker internal boundary for the Connections GUI.
# Use a generated secret outside local dev; never expose this route publicly.
PROVISIONING_INTERNAL_URL=http://workers.opzava.localhost:19089
PROVISIONING_INTERNAL_TOKEN=opzava_local_dev_provisioning_internal_token_not_for_shared_envs
NODE_ENV=development

# Optional local MinIO/S3-compatible object store for task card Evidence & Files.
# These fixed values are for local Compose only; use managed secrets outside a
# single-developer environment.
OBJECT_STORE_BUCKET=opzava-task-evidence
OBJECT_STORE_REGION=us-east-1
OBJECT_STORE_ENDPOINT=http://127.0.0.1:19000
# Docker-service endpoint used by docker-compose web; browser/local dev uses OBJECT_STORE_ENDPOINT.
COMPOSE_OBJECT_STORE_ENDPOINT=http://minio:9000
OBJECT_STORE_ACCESS_KEY_ID=opzava_minio_local
OBJECT_STORE_SECRET_ACCESS_KEY=opzava_minio_local_only_not_for_shared_envs
MINIO_ROOT_USER=opzava_minio_local
MINIO_ROOT_PASSWORD=opzava_minio_local_only_not_for_shared_envs
# Keep latest while the local MinIO contract is still being shaken out; pin after
# the first shared/live verified run.
MINIO_IMAGE_TAG=latest
MINIO_MC_IMAGE_TAG=latest

# Optional GitHub issues integration. GITHUB_TOKEN must be set only in a local
# shell, local dev vault, or managed secret store; never commit a real token.
GITHUB_ISSUES_REPOSITORY=anthonykewl20/opzava
# Optional GitHub OAuth App client id for the Connections GUI device flow.
# This is not a secret; OAuth access tokens still go only to SecretsVaultPort.
# GITHUB_OAUTH_CLIENT_ID=<github-oauth-app-client-id>
# GITHUB_TOKEN=<fine-grained-token-with-issues-read-write>
# ISSUE_CLOSE_ORG_ID=<org-id-for-close-outbox-worker>
# ISSUE_CLOSE_WORKSPACE_ID=<workspace-id-for-close-outbox-worker>
# ISSUE_CLOSE_ACTOR_USER_ID=<service-user-id-for-close-outbox-worker>
# ISSUE_CLOSE_ROLE_KEYS=admin

# Optional OpenClaw platform Gateway profile. Default `docker compose up` does
# not start it; use `docker compose --profile openclaw up`.
OPENCLAW_IMAGE_TAG=2026.6.11
OPENCLAW_GATEWAY_URL=ws://127.0.0.1:18789
OPENCLAW_DEV_SECRETS_FILE=/tmp/opzava-openclaw-dev-secrets.json
# Set these only in a local shell or secret manager; do not commit real values.
# OPENCLAW_GATEWAY_TOKEN=<local-only-openclaw-gateway-token>
# OPENCLAW_OPERATOR_DEVICE_TOKEN=<paired-operator-device-token>
# OPENCLAW_DEVICE_PRIVATE_KEY_PEM_BASE64=<base64-ed25519-private-key-pkcs8-pem>
# Optional consistency-checked overrides; normally derived from the private key.
# OPENCLAW_DEVICE_ID=<sha256-hex-raw-ed25519-public-key>
# OPENCLAW_DEVICE_PUBLIC_KEY=<raw-ed25519-public-key-base64url>

# Optional local-only roadmap seed overrides. If unset, `pnpm seed:roadmap`
# uses dev-only defaults from apps/workers/src/seed/roadmap.ts. Shared and live
# environments must set their own SEED_OWNER_* values and must not reuse local
# defaults.
# SEED_OWNER_EMAIL=owner@opzava.localhost
# SEED_OWNER_PASSWORD=<12+ chars, at least 3 character classes>
# SEED_OWNER_NAME=Opzava Owner
# SEED_ORG_NAME=Opzava Internal
# SEED_WORKSPACE_NAME=Admin
# SEED_TIMEZONE=Asia/Manila

# The database passwords above are fixed local-development credentials created
# by db/init/00-roles.sql on a fresh Docker Compose volume. Do not use them in
# shared or live environments.

# BETTER_AUTH_SECRET above is a fixed local-development value. Generate a managed
# secret for shared or live environments; do not reuse the example value there.

# BROKER_INTERNAL_TOKEN above is a fixed local-development value for the
# web -> gateway-broker internal auth boundary. Generate a managed secret for
# shared or live environments; do not reuse the example value there.

# PROVISIONING_INTERNAL_TOKEN above is a fixed local-development value for the
# web -> provisioning-worker internal auth boundary. Generate a managed secret
# for shared or live environments; do not reuse the example value there.
