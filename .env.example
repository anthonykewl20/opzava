# Opzava environment configuration template.
# Copy to `.env` and replace placeholder values. Never commit the real `.env`.
# Secrets (AUTH_PASS, API_KEY, AUTH_SECRET) auto-generate on first run if left blank.

# --- Server ---
PORT=3000
# Host-side port used by docker-compose.yml and the Makefile status URL.
MC_PORT=3000
MC_URL_SCHEME=http
MC_HOST=127.0.0.1
# Hostnames the app will accept requests from in production (comma-separated).
# Leave unset for local dev. Required for any network-facing deploy.
# MC_ALLOWED_HOSTS=opzava.anito.ai
# MC_ALLOW_ANY_HOST=0              # NEVER set to 1 in production
# NEXT_PUBLIC_FORCE_HTTPS=1         # opt-in HTTPS redirect (set behind a TLS proxy)

# --- Docker operator workflow ---
MC_MODE=prod                       # prod or dev
OPENCLAW_ENABLED=0                 # set 1 to include docker-compose-openclaw.yml
MC_HOST_CLI_ENABLED=0              # set 1 to include docker-compose.host-cli.yml
INSTALL_AGENT_CLIS=1               # bake claude/codex CLIs into the runtime image
NEXT_PUBLIC_CHAT_POLL_INTERVAL_MS=1000

# --- Local Dokploy parity ---
DOKPLOY_LOCAL_DOMAIN=opzava.localhost
DOKPLOY_GATEWAY_LOCAL_DOMAIN=opzava-gateway.localhost
DOKPLOY_HTTP_PORT=3080
DOKPLOY_TRAEFIK_IMAGE=traefik:v3.7.5
# OPZAVA_IMAGE=opzava-dokploy-local
# DOKPLOY_PARITY_RUN_E2E=1

# --- Auth & secrets (auto-generated on first run if blank) ---
AUTH_USER=admin
# AUTH_PASS=                        # strong 12+ char password; or use AUTH_PASS_B64 (base64)
# AUTH_PASS_B64=
# AUTH_SECRET=                      # session signing secret (random)
# API_KEY=                          # API key for headless/agent access (random)

# --- Data location ---
# MISSION_CONTROL_DATA_DIR=.data    # absolute path recommended for standalone deploys
# MISSION_CONTROL_DB_PATH=          # overrides <DATA_DIR>/mission-control.db

# --- Cookies / transport hardening (set behind TLS) ---
# MC_COOKIE_SECURE=1
# MC_COOKIE_SAMESITE=strict
# MC_ENABLE_HSTS=1

# --- Rate limiting ---
# MC_DISABLE_RATE_LIMIT=            # leave unset in production; set 1 only for local/test
# MC_TRUSTED_PROXIES=               # comma-separated trusted proxy IPs/cidrs for correct client IP

# --- Gateway (optional — app runs standalone without one) ---
NEXT_PUBLIC_GATEWAY_OPTIONAL=true
# NEXT_PUBLIC_GATEWAY_HOST=         # browser-reachable gateway host
# NEXT_PUBLIC_GATEWAY_PORT=18789
# NEXT_PUBLIC_GATEWAY_PROTOCOL=ws
# NEXT_PUBLIC_GATEWAY_REVERSE_PROXY=0
# OPENCLAW_STATE_DIR=~/.openclaw
# OPENCLAW_GATEWAY_HOST=host.docker.internal
# OPENCLAW_GATEWAY_PORT=18789
# OPENCLAW_GATEWAY_TOKEN=
# OPENCLAW_CONFIG_PATH=             # path to openclaw.json
# MC_DEFAULT_GATEWAY_NAME=primary

# --- Gateway-free direct dispatch ---
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
LOCAL_LLM_ENDPOINT=http://host.docker.internal:1234/v1
# LOCAL_LLM_API_KEY=
MC_HOST_SESSION_MODE=coexist        # coexist, block-active, or nudge

# --- Integrations ---
# MC_CLAUDE_HOME=~/.claude
# MC_WEBHOOK_MAX_RETRIES=5
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# NEXT_PUBLIC_APP_URL=

# --- Opzava provider connections (configured in the Settings UI, not here) ---
# WordPress site URL + app password, Resend API key, and sender identity are stored
# as admin settings via the Settings → Provider Connections panel. Use "Test" there
# to validate each live connection before running real workflows.
